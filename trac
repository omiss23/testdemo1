def build_dashboard(wb, sel):
    ws = wb.create_sheet('Dashboard')
    ws.sheet_properties.tabColor = TAB['dash']
    ws.sheet_view.showGridLines = False
    w = {'A': 2, 'N': 2}
    w.update({c: 12.5 for c in 'BCDEFGHIJLM'})
    w['K'] = 15
    widths(ws, w)
    for c in 'PQ':
        ws.column_dimensions[c].hidden = True
    put(ws, 'B1', 'Attendance Dashboard', F(18, True, color=GREEN), align=A_L)
    ws.row_dimensions[1].height = 30
    put(ws, 'B2', '="Year "&YearSel&"   \xb7   "&IF(MonthSel="All","All months",MonthSel)'
                  '&"   \xb7   Team: "&TeamSel&"   \xb7   Sub Team: "&SubSel', F(10, color=MUTED), align=A_L)
    y, mo, t, s = sel
    for c1, c2, lab, val, src, word in [('B', 'C', 'YEAR', y, 'YearList', 'year'),
                                        ('D', 'E', 'MONTH', mo, 'MonthListAll', 'month'),
                                        ('F', 'G', 'TEAM', t, 'TeamListDash', 'team'),
                                        ('H', 'I', 'SUB TEAM', s, 'SubTeamListDash', 'sub team')]:
        put(ws, f'{c1}4', lab, F(8, True, color=MUTED), align=A_L)
        ws.merge_cells(f'{c1}5:{c2}5')
        for c in (c1, c2):
            put(ws, f'{c}5', None, F(11, True), FILL(INPUT), B_BOX, A_C, '0', unlocked=True)
        ws[f'{c1}5'].value = val
        dv_list(ws, f'{c1}5', src, 'Pick from the list', f'Choose a {word} from the dropdown.')
    ws.row_dimensions[5].height = 24
    ws.merge_cells('J5:M5')
    put(ws, 'J5', WARN, F(9, True, color='C0392B'), align=A_LW)
    put(ws, 'B6', 'Pick filters in the yellow boxes  \xb7  Month = All shows the whole year in the cards  \xb7  '
                  'Team and Sub Team lists come from the Setup tab', F(8, italic=True, color=MUTED), align=A_L)

    def kpi(col):
        return (f'=IFERROR(IF(MonthSel="All",${col}$43,'
                f'INDEX(${col}$31:${col}$42,MATCH(MonthSel,$B$31:$B$42,0))),0)')

    def cap(unit):
        return f'=IF(MonthSel="All","{unit} \xb7 all of "&YearSel,"{unit} \xb7 "&MonthSel&" "&YearSel)'

    emp = ('=SUMPRODUCT((MasterID<>"")*(MasterStatus<>"Inactive")'
           '*(((TeamSel="All")+(MasterTeam=TeamSel))>0)*(((SubSel="All")+(MasterSub=SubSel))>0))')
    cards = [('B', 'C', 'EMPLOYEES', emp, 'active in Employee Master', '1F2937', '#,##0'),
             ('D', 'E', 'PRESENT', kpi('C'), cap('person-days'), '2F5597', '#,##0'),
             ('F', 'G', 'LEAVE', kpi('D'), cap('person-days'), 'C55A11', '#,##0'),
             ('H', 'I', 'EARLY MORNING', kpi('E'), cap('shifts'), '1B7F6E', '#,##0'),
             ('J', 'K', 'LATE EVENING', kpi('F'), cap('shifts'), '6B4FA0', '#,##0'),
             ('L', 'M', 'ATTENDANCE %', '=IF(D8+F8=0,"\u2013",D8/(D8+F8))', 'present \xf7 (present + leave)',
              '1F7A3F', '0.0%')]
    for c1, c2, lab, formula, capt, color, fmt in cards:
