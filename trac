# ================================================================ style helpers
_fc = {}


def F(size=10, bold=False, italic=False, color=TXT, underline=None):
    k = (size, bold, italic, color, underline)
    if k not in _fc:
        _fc[k] = Font(name='Arial', size=size, bold=bold, italic=italic, color=color,
                      underline=underline)
    return _fc[k]


def CFF(bold=False, italic=False, color=None):          # font for conditional formats
    return Font(bold=bold, italic=italic, color=color)


def FILL(h):
    return PatternFill('solid', start_color=h, end_color=h)


S_GRID = Side(style='thin', color='D9D9D9')
S_BOX = Side(style='thin', color='BFBFBF')
B_GRID = Border(left=S_GRID, right=S_GRID, top=S_GRID, bottom=S_GRID)
B_BOX = Border(left=S_BOX, right=S_BOX, top=S_BOX, bottom=S_BOX)
A_C = Alignment(horizontal='center', vertical='center')
A_CW = Alignment(horizontal='center', vertical='center', wrap_text=True)
A_L = Alignment(horizontal='left', vertical='center')
A_LW = Alignment(horizontal='left', vertical='center', wrap_text=True)
A_LT = Alignment(horizontal='left', vertical='top', wrap_text=True)
A_R = Alignment(horizontal='right', vertical='center')
A_RT = Alignment(horizontal='right', vertical='top')
UNLOCK = Protection(locked=False)


def put(ws, ref, value=None, font=None, fill=None, border=None, align=None, fmt=None,
        unlocked=False):
    c = ws[ref]
    if value is not None:
        c.value = value
    if font is not None:
        c.font = font
    if fill is not None:
        c.fill = fill
    if border is not None:
        c.border = border
    if align is not None:
        c.alignment = align
    if fmt is not None:
        c.number_format = fmt
    if unlocked:
        c.protection = UNLOCK
    return c


def header(ws, ref, text, size=10):
    put(ws, ref, text, F(size, True, color='FFFFFF'), FILL(GREEN), B_BOX, A_CW)


def widths(ws, spec):
    for col, w in spec.items():
        ws.column_dimensions[col].width = w


def protect(ws, allow_sort=False, allow_filter=False, objects=False):
    p = ws.protection
    p.sheet = True
    p.sort = not allow_sort              # True = blocked
    p.autoFilter = not allow_filter
    p.formatColumns = False              # resizing columns/rows allowed
    p.formatRows = False
    p.formatCells = False
    p.insertRows = p.deleteRows = p.insertColumns = p.deleteColumns = True
    p.objects = objects


def page(ws, landscape=False, fit_height=0, area=None, titles=None):
    ws.page_setup.orientation = 'landscape' if landscape else 'portrait'
    ws.page_setup.paperSize = ws.PAPERSIZE_A4
    ws.sheet_properties.pageSetUpPr = PageSetupProperties(fitToPage=True)
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = fit_height
    if area:
        ws.print_area = area
    if titles:
        ws.print_title_rows = titles


def add_name(wb, name, ref):
    dn = DefinedName(name, attr_text=ref)
    try:
        wb.defined_names[name] = dn              # openpyxl 3.1 and later
    except Exception:
        wb.defined_names.append(dn)              # openpyxl 3.0.x


def cf(ws, rng, formula, fill=None, font=None, stop=False):
    ws.conditional_formatting.add(rng, FormulaRule(formula=[formula], stopIfTrue=stop,
                                                   fill=FILL(fill) if fill else None, font=font))


def dv_list(ws, rng, source, title, msg, style='stop'):
    dv = DataValidation(type='list', formula1=source, allow_blank=True, showErrorMessage=True,
                        errorStyle=style, errorTitle=title, error=msg)
    dv.add(rng)
    ws.add_data_validation(dv)


def dv_num(ws, rng, kind, lo, hi, title, msg, style='stop'):
    dv = DataValidation(type=kind, operator='between', formula1=str(lo), formula2=str(hi),
                        allow_blank=True, showErrorMessage=True, errorStyle=style,
                        errorTitle=title, error=msg)
    dv.add(rng)
    ws.add_data_validation(dv)


# ---- charts
def _cp(sz, b=False):
    return CharacterProperties(latin=DFont(typeface='Arial'), sz=sz, b=b)


def chart_txt(sz=900):
    cp = _cp(sz)
    return RichText(p=[Paragraph(pPr=ParagraphProperties(defRPr=cp), endParaRPr=cp)])


def chart_title(text):
    cp = _cp(1100, True)
    para = Paragraph(pPr=ParagraphProperties(defRPr=cp), r=[RegularTextRun(rPr=cp, t=text)])
    return Title(tx=Text(rich=RichText(p=[para])), overlay=False)


def bar_chart(ws, title, min_col, colors, anchor):
    ch = BarChart()
    ch.type, ch.grouping = 'col', 'clustered'
    ch.add_data(Reference(ws, min_col=min_col, max_col=min_col + 1, min_row=30, max_row=42),
                titles_from_data=True)
    ch.set_categories(Reference(ws, min_col=2, min_row=31, max_row=42))
    ch.title = chart_title(title)
    ch.legend.position = 'b'
    ch.legend.txPr = chart_txt()
    ch.x_axis.delete = False
    ch.y_axis.delete = False
    ch.x_axis.txPr = chart_txt()
    ch.y_axis.txPr = chart_txt()
    ch.y_axis.scaling.min = 0
    ch.gapWidth = 60
    ch.width, ch.height = 14.2, 8.0
    for s, col in zip(ch.series, colors):
        s.graphicalProperties = GraphicalProperties(solidFill=col, ln=LineProperties(solidFill=col))
    ws.add_chart(ch, anchor)


